<Window x:Class="AgencyEmploymentApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — Агентство по трудоустройству"
        Height="610" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Border Width="410"
                Padding="34"
                Background="White"
                CornerRadius="14"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#1F3A5F" Opacity="0.12" BlurRadius="24" ShadowDepth="4" />
            </Border.Effect>
            <StackPanel>
                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="Агентство по трудоустройству"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Информационная система подбора персонала"
                                   Foreground="#C9D6E8"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Вход в систему"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,18" />

                <TextBlock Text="Логин" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="LoginBox"
                         Height="38"
                         Padding="10,8"
                         FontSize="14"
                         BorderBrush="#C9D3E0"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Пароль" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5" />
                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             Padding="10,8"
                             FontSize="14"
                             BorderBrush="#C9D3E0"
                             VerticalContentAlignment="Center"
                             KeyDown="PasswordBox_KeyDown" />

                <Button x:Name="LoginButton"
                        Content="Войти"
                        Height="42"
                        Margin="0,22,0,0"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="LoginButton_Click" />

                <TextBlock x:Name="StatusText"
                           Foreground="#D64545"
                           TextWrapping="Wrap"
                           MinHeight="22"
                           Margin="0,12,0,0" />

                <Border Background="#EEF4FF" CornerRadius="7" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Тестовые учётные записи"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,5" />
                        <TextBlock Text="seeker01 / Seeker123! — соискатель"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="employer01 / Employer123! — работодатель"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="admin01 / Admin123! — администратор"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
