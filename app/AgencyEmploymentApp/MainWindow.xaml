<Window x:Class="AgencyEmploymentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Агентство по трудоустройству — главное окно"
        Height="760" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Агентство по трудоустройству"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Информационная система подбора персонала"
                               Foreground="#C9D6E8"
                               FontSize="12"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="UserRoleText"
                                   Foreground="#C9D6E8"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Выйти"
                            Width="86"
                            Height="34"
                            Background="#2F80ED"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="20,16,20,10"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="13">
            <TabItem Header="Резюме">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ResumesSummary"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,0,0,8" />
                    <DataGrid x:Name="ResumesGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EEF6"
                              RowBackground="White"
                              AlternatingRowBackground="#F7FAFF"
                              Background="White"
                              BorderBrush="#DCE4EF"
                              BorderThickness="1"
                              ColumnHeaderHeight="36"
                              RowHeight="30"
                              FontSize="12.5">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EAF1FB" />
                                <Setter Property="Foreground" Value="#1F3A5F" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#DCE4EF" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="200" />
                            <DataGridTextColumn Header="Желаемая должность" Binding="{Binding DesiredPosition}" Width="200" />
                            <DataGridTextColumn Header="Опыт" Binding="{Binding Experience}" Width="*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Опубликовано" Binding="{Binding PublishedAt}" Width="110" />
                            <DataGridTextColumn Header="Согласие" Binding="{Binding Consent}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Вакансии">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="VacanciesSummary"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,0,0,8" />
                    <DataGrid x:Name="VacanciesGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EEF6"
                              RowBackground="White"
                              AlternatingRowBackground="#F7FAFF"
                              Background="White"
                              BorderBrush="#DCE4EF"
                              BorderThickness="1"
                              ColumnHeaderHeight="36"
                              RowHeight="30"
                              FontSize="12.5">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EAF1FB" />
                                <Setter Property="Foreground" Value="#1F3A5F" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#DCE4EF" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="190" />
                            <DataGridTextColumn Header="Должность" Binding="{Binding PositionTitle}" Width="180" />
                            <DataGridTextColumn Header="Оклад" Binding="{Binding Salary}" Width="110" />
                            <DataGridTextColumn Header="Тип занятости" Binding="{Binding EmploymentType}" Width="140" />
                            <DataGridTextColumn Header="Принцип работы" Binding="{Binding WorkMode}" Width="130" />
                            <DataGridTextColumn Header="Открыта" Binding="{Binding OpenedAt}" Width="95" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Отклики">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ApplicationsSummary"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="2,0,0,8" />
                    <DataGrid x:Name="ApplicationsGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EEF6"
                              RowBackground="White"
                              AlternatingRowBackground="#F7FAFF"
                              Background="White"
                              BorderBrush="#DCE4EF"
                              BorderThickness="1"
                              ColumnHeaderHeight="36"
                              RowHeight="30"
                              FontSize="12.5">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EAF1FB" />
                                <Setter Property="Foreground" Value="#1F3A5F" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#DCE4EF" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Соискатель (резюме)" Binding="{Binding ResumeUser}" Width="200" />
                            <DataGridTextColumn Header="Должность" Binding="{Binding PositionTitle}" Width="180" />
                            <DataGridTextColumn Header="Вакансия пользователя" Binding="{Binding VacancyUser}" Width="200" />
                            <DataGridTextColumn Header="Дата отклика" Binding="{Binding ResponseDate}" Width="110" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="#EAF1FB" BorderBrush="#DCE4EF" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
